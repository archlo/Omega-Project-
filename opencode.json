{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "ida": {
      "type": "local",
      "command": ["ida-mcp", "proxy"],
      "enabled": true
